FROM photon:4.0

RUN tdnf update -y --refresh && \
    tdnf remove -y toybox && \
    tdnf install -y \
        build-essential \
        cmake \
        createrepo_c \
        curl-devel \
        findutils \
        glib \
        gpgme-devel \
        libsolv-devel \
        libxml2 \
        libxml2-devel \
        openssl-devel \
        popt-devel \
        python3-devel \
        python3-pip \
        python3-pyOpenSSL \
        python3-pytest \
        python3-requests \
        python3-setuptools \
        python3-urllib3 \
        rpm-build \
        sed \
        shadow \
        sudo \
        valgrind \
        which \
        zlib-devel && \
    tdnf install -y --disablerepo=* --enablerepo=photon-debuginfo --setopt=skip_md_filelists=1 \
        glibc-debuginfo-$(rpm -q --qf %{version}-%{release} glibc) && \
    pip3 install --no-cache-dir flake8 && \
    tdnf clean all && \
    rm -rf /var/cache/tdnf/*

CMD ["/bin/bash"]
